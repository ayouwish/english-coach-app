<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ===== Bundle 基本信息（版本/名称走 project.yml 的 xcconfig 变量） ===== -->
    <key>CFBundleDevelopmentRegion</key>
    <string>zh-Hans</string>
    <key>CFBundleDisplayName</key>
    <string>English Coach</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <!-- 无自定义加密（仅系统 HTTPS / Keychain），TestFlight 上传时如实声明。 -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- ===== 权限文案（中文，家长和孩子都读得懂） =====
         麦克风文案必须如实：录音会经家里服务器转发给云端语音服务（hybrid 模式音频会离开家庭网络），
         不得写“录音只留在家里/不出户”。 -->
    <key>NSMicrophoneUsageDescription</key>
    <string>需要使用麦克风录制你的朗读。录音会上传到家里的学习服务器，并转发给云端语音服务用于识别和发音评分。</string>
    <key>NSCameraUsageDescription</key>
    <string>故事模式需要拍下书页或绘本，用来生成英文小故事。照片会上传到家里的学习服务器，并转发给云端识别服务做文字识别。</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>把生成的故事插画保存到你的相册。</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>用于连接家庭内网的学习服务器。只有在你把服务器地址填成局域网 IP 时才会用到。</string>

    <!-- ===== 界面方向：仅竖屏（iPhone / iPad 都只允许 portrait，契约 §5） ===== -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIRequiresFullScreen</key>
    <true/>
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleDarkContent</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UIUserInterfaceStyle</key>
    <string>Light</string>

    <!-- ===== 后台模式：只用于播放 TTS/故事音频，不用于后台录音 ===== -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>

    <!-- ===== ATS（App Transport Security）：默认不开放任何例外 =====
         后端只应通过受信任的 HTTPS 证书访问（NAS 上换 Let's Encrypt / 受信任证书，
         或在测试设备上安装并信任内网 CA 描述文件）。
         自签证书不会因为“只是 TestFlight 内测”而被豁免；NSExceptionDomains 仅排障期临时使用。
         明文 http://192.168.x.x 只允许在 Debug 排障时手动填写，且 token 会明文传输。
         本文件故意不写 NSAppTransportSecurity —— 系统默认即“禁止明文、无例外”。 -->
</dict>
</plist>
